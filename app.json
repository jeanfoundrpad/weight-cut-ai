{
  "expo": {
    "name": "Weight Cut AI",
    "slug": "weight-cut-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "weightcutai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.weightcutai.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Weight Cut AI uses your camera to photograph meals and scan grocery barcodes for calorie and macro estimation.",
        "NSPhotoLibraryUsageDescription": "Weight Cut AI uses your photo library so you can add a profile picture to your claimed fighter profile."
      }
    },
    "android": {
      "package": "com.weightcutai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Weight Cut AI uses your camera to photograph meals and scan grocery barcodes for calorie and macro estimation."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Weight Cut AI uses your photo library so you can add a profile picture to your claimed fighter profile."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://mtcwcvyshcdllzdhwxfa.supabase.co",
      "supabaseUrl": "https://mtcwcvyshcdllzdhwxfa.supabase.co",
