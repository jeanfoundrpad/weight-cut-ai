# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local state (project ref, org id, pooler hostname) — found
# missing by a Fable 5 review before this repo's first real commit; without
# this, a routine `git add -A` would have swept it into version control.
# Covers both locations: backend/supabase is the real linked project, and
# a stray root-level supabase/.temp/ gets created too if the CLI is ever
# run from the repo root instead of backend/ (happened during a 2026-09-24
# debugging session).
backend/supabase/.temp/
backend/supabase/.branches/
/supabase/.temp/
/supabase/.branches/

# Python
__pycache__/
*.pyc

# Scraper output -- scraped fighter data, not source, and not something
# that belongs in a public repo (real names/gyms pulled from third-party
# sites, plus timestamped backups of the same).
backend/scraper/output/
